import os
import numpy.fft as fp
import numpy as np
import matplotlib.pyplot as plt
from skimage.io import imread

os.chdir(r'G:\다른 컴퓨터\내 노트북\Programming\디지털영상처리\lecture10')

def plot_image(image, title=''):
    plt.imshow(image)
    plt.axis('off')
    plt.title(title, size=16)

srcImg = np.mean(imread('bricks.jpg'), axis=2)

freqDomain = fp.fft2(srcImg)
freqFilter = fp.fftshift(freqDomain)

spectrum = 20 * np.log10(0.1 + np.abs(freqFilter))

height, width = freqDomain.shape
center_y, center_x = height // 2, width // 2

filter_size = 20

freqFilter[
    center_y-filter_size:center_y+filter_size,
    center_x-filter_size:center_x+filter_size
] = 0

resImg = np.clip(
    fp.ifft2(fp.ifftshift(freqFilter)).real,
    0,
    255
)

plt.figure(figsize=(15, 10))
plt.gray()

plt.subplot(2, 2, 1)
plot_image(srcImg, 'Original Image')

plt.subplot(2, 2, 2)
plot_image(spectrum, 'Fourier Spectrum')

plt.subplot(2, 2, 3)
plot_image(np.log10(0.1 + np.abs(freqFilter)), 'Filtered Spectrum')

plt.subplot(2, 2, 4)
plot_image(resImg, 'HPF Result')

plt.tight_layout()
plt.show()